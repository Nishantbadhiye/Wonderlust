pipeline {
    agent any

    tools {
        jdk 'jdk21'
        maven 'maven'
    }

    environment {
        DOCKER_IMAGE = "nishantbadhiye07/wanderlust:latest"
        SCANNER_HOME = tool 'sonar-scanner'
    }
stages {

        stage("Workspace cleanup"){
            steps{
                script{
                    cleanWs()
                }
            }
        }

        stage('Git Checkout') {
            steps {
                git "https://github.com/Nishantbadhiye/Wonderlust.git" branch: "main"
            }
        }

        stage('File System Scan') {
            steps {
                sh "trivy fs --format table -o trivy-fs-report.html ."
            }
        }

        stage('Maven Build') {
            steps {
                sh "mvn clean package -DskipTests=true"
            }
        }


       stage('SonarQube Analysis') {
            steps {
                script {
                    withSonarQubeEnv('sonar') {
                        sh 'mvn sonar:sonar'
                    }
                }
            }
        }


        stage('Publish to Nexus') {
            steps {
                withMaven(
                    globalMavenSettingsConfig: 'maven-setting',
                    jdk: 'jdk21',
                    maven: 'maven'
                ) {
                    sh "mvn deploy"
                }
            }
        }

        stage('Build and Push Image') {
            steps {
                script {
                    env.IMAGE_TAG = "build-${BUILD_NUMBER}"

                    withCredentials([usernamePassword(
                        credentialsId: 'docker-cred',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )]) {
                        sh """
                        docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .
                        echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                        docker push ${IMAGE_NAME}:${IMAGE_TAG}
                        """
                    }
                }
            }
        }

        stage('Docker Image Scan') {
            steps {
                sh "trivy image --format table -o trivy-image-report.html ${DOCKER_IMAGE}"
                archiveArtifacts artifacts: 'trivy-image-report.html', fingerprint: true
            }
        }


        stage("Deploy using Docker compose"){
            steps{
                sh "docker-compose up -d"
            }
        }

    }
}
